            ],
            "formatString": "▲0.00%\" vs PQ\";▼0.00%\" vs PQ\";▬0.00%\" vs PQ\"",
            "lineageTag": "41f31cc9-5b65-48d2-8ef7-969998b7374e"
          },
          {
            "name": "margin_qoq (pts)",
            "description": "Gross margin vs the prior fiscal quarter, in percentage points, compared like-for-like on elapsed days. Blank unless exactly one quarter is in context and the prior window falls within available history.",
            "displayFolder": "Growth Rate",
            "expression": [
              "VAR MinD = MIN('Date table'[Date])",
              "VAR MaxD = MAX('Date table'[Date])",
              "VAR FirstSale = CALCULATE(MIN(Fact_table[invoice_date]), REMOVEFILTERS(Fact_table), REMOVEFILTERS('Date table'))",
              "VAR LastSale = CALCULATE(MAX(Fact_table[invoice_date]), REMOVEFILTERS(Fact_table), REMOVEFILTERS('Date table'))",
              "VAR EffEnd = MIN(MaxD, LastSale)",
              "VAR Days = DATEDIFF(MinD, EffEnd, DAY) + 1",
              "VAR PQStart = EDATE(MinD, -3)",
              "VAR PQEnd = MIN(PQStart + Days - 1, MinD - 1)",
              "VAR Cur = CALCULATE([Profit Margin (%)], DATESBETWEEN('Date table'[Date], MinD, EffEnd))",
              "VAR Prv = CALCULATE([Profit Margin (%)], DATESBETWEEN('Date table'[Date], PQStart, PQEnd))",
              "RETURN",
              "    IF(",
              "        [Quarters In Context] = 1 && PQStart >= FirstSale",
              "            && NOT ISBLANK(Cur) && NOT ISBLANK(Prv),",
              "        Cur - Prv",
              "    )"
            ],
            "formatString": "▲0.00%\" pts vs PQ\";▼0.00%\" pts vs PQ\";▬0.00%\" pts vs PQ\"",
            "lineageTag": "6cee9758-760a-490b-9ec6-f7563645926b"
          },
          {
            "name": "margin_qoq_colour",
            "description": "Hex colour for [margin_qoq (pts)].",
            "displayFolder": "Formatting",
            "expression": [
              "VAR v = [margin_qoq (pts)]",
              "RETURN",
              "    SWITCH(TRUE(), ISBLANK(v), \"#605E5C\", v > 0, \"#107C10\", v < 0, \"#D13438\", \"#000000\")"
            ],
            "isHidden": true,
            "lineageTag": "4765500b-3537-4d08-823d-5f0a27632b4a"
          },
          {
            "name": "KPI Spark - Profit Margin",
            "dataCategory": "ImageUrl",
            "description": "Option 1 sparkline card for Profit Margin. ImageUrl: render at 362x165. Headline turns red when margin is negative. Deltas are percentage points, not percent change. Figures wrong until the TDNGCI-168846 cost row is corrected.",
            "displayFolder": "KPI Cards",
            "expression": [
              "VAR W = 362",
              "VAR H = 165",
              "VAR SpkTop = 112",
              "VAR SpkBot = 161",
              "VAR Line = \"rgb(143,48,48)\"",
              "VAR Grey = \"rgb(120,115,111)\"",
              "VAR Red = \"rgb(196,48,43)\"",
              "VAR Green = \"rgb(27,107,27)\"",
              "VAR Val = [Profit Margin (%)]",
              "VAR M = [margin_mom (pts)]",
              "VAR Q = [margin_qoq (pts)]",
              "VAR Y = [margin_yoy (pts)]",
              "VAR ValCol = IF(Val < 0, Red, \"rgb(18,16,15)\")",
              "VAR Pts = FILTER(ADDCOLUMNS(VALUES('Date table'[Month]), \"@v\", [Profit Margin (%)]), NOT ISBLANK([@v]))",
              "VAR N = COUNTROWS(Pts)",
              "VAR MaxV = MAXX(Pts, [@v])",
              "VAR MinV = MINX(Pts, [@v])",
              "VAR Rk = ADDCOLUMNS(Pts, \"@i\", RANKX(Pts, 'Date table'[Month], , ASC, DENSE))",
