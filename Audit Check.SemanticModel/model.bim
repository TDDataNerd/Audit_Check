            "sourceColumn": "[Fiscal Year-Month]",
            "summarizeBy": "none",
            "type": "calculatedTableColumn"
          }
        ],
        "dataCategory": "Time",
        "lineageTag": "2bc61408-d34c-48ac-a104-a37ec92b59ab",
        "partitions": [
          {
            "name": "Date table",
            "mode": "import",
            "source": {
              "expression": [
                "",
                "VAR MinDateRaw =",
                "    CALCULATE(MIN(Fact_table[invoice_date]), ALL( 'fact_table'))",
                "VAR MaxDateRaw =",
                "    CALCULATE( MAX(Fact_table[invoice_date]), ALL('fact_table'))",
                " ",
                "/* safety fallback if your fact has no dates */",
                "VAR MinDateSafe =",
                "    IF( NOT( ISBLANK( MinDateRaw ) ), MinDateRaw, DATE( YEAR( TODAY() ), 1, 1 ) )",
                "VAR MaxDateSafe =",
                "    IF( NOT( ISBLANK( MaxDateRaw ) ), MaxDateRaw, DATE( YEAR( TODAY() ), 12, 31 ) )",
                " ",
                "VAR StartDate = DATE( YEAR( MinDateSafe ), 1, 1 )   /* start of year of min date */",
                "VAR EndDate =",
                "    IF(",
                "        MONTH(MaxDateSafe) < 4,",
                "        DATE(YEAR(MaxDateSafe), 3, 31),",
                "        DATE(YEAR(MaxDateSafe) + 1, 3, 31)",
                "    )",
                " ",
                " ",
                "RETURN",
                "ADDCOLUMNS(",
                "    CALENDAR( StartDate, EndDate ),",
                " ",
                "    /* Gregorian */",
                "    \"Year\", YEAR( [Date] ),",
                "    \"Cal Quarter Number\", QUARTER( [Date] ),",
                "    \"Cal Qtr Name\", \"Q\" & FORMAT( QUARTER( [Date] ), \"0\" ),",
                "    \"Month\", MONTH( [Date] ),",
                "    \"Month Name\", FORMAT( [Date], \"MMMM\" ),",
                "    \"Month Name Short\", FORMAT( [Date], \"MMM\" ),",
                "    \"Day\", DAY( [Date] ),",
                "    /* WEEKDAY with return_type = 1 gives Sunday = 1 .. Saturday = 7 (matches your M +1) */",
                "    \"Weekday\", WEEKDAY( [Date], 1 ),",
                "    \"Day Name\", FORMAT( [Date], \"dddd\" ),",
                "    \"Day Name Short\", FORMAT( [Date], \"ddd\" ),",
                "    \"Is Weekend\", IF( WEEKDAY( [Date], 1 ) IN { 1, 7 }, \"Weekend\", \"Weekday\" ),",
                "    /*Fiscal Week Number (April–March) */",
                "    \"Fiscal WeekNum\",",
                "        VAR FiscalStartMonth = 4",
                "        VAR FiscalStartYear =",
                "            IF(MONTH([Date]) >= FiscalStartMonth, YEAR([Date]), YEAR([Date]) - 1)",
                "        VAR FiscalStartDate = DATE(FiscalStartYear, FiscalStartMonth, 1)",
                "        VAR DaysSinceStart = DATEDIFF(FiscalStartDate, [Date], DAY)",
                "        RETURN",
                "            ROUNDDOWN(DaysSinceStart / 7, 0) + 1,",
                " ",
                " ",
                "    /* Fiscal (FY starts in April) */",
                "    \"FY\",",
                "        \"FY\"",
                "        & RIGHT(",
                "            FORMAT(",
                "                IF( MONTH( [Date] ) >= 4, YEAR( [Date] ) + 1, YEAR( [Date] ) ),",
                "                \"0000\"",
                "            ),",
                "            2",
                "        ),",
                "    \"FY Month Number\",",
                "        /* shifted = rawMonth - FiscalStartMonth + 1  where FiscalStartMonth = 4 -> raw - 3 */",
                "        VAR raw = MONTH( [Date] )",
                "        VAR shifted = raw - 3",
                "        RETURN IF( shifted <= 0, shifted + 12, shifted ),",
                "    \"Fiscal Quarter Number\",",
                "        VAR raw2 = MONTH( [Date] )",
                "        VAR shifted2 = IF( raw2 - 3 <= 0, raw2 - 3 + 12, raw2 - 3 )",
                "        RETURN INT( ( shifted2 + 2 ) / 3 ),",
                "    \"Fiscal Quarter\",",
                "        \"Q\" & FORMAT(",
                "            INT(",
                "                (",
                "                    IF( MONTH( [Date] ) - 3 <= 0,",
                "                        MONTH( [Date] ) - 3 + 12,",
                "                        MONTH( [Date] ) - 3",
                "                    ) + 2",
                "                ) / 3",
                "            ),",
                "            \"0\"",
                "        ),",
                " ",
                "    /* Fiscal Half Year */",
                "    \"Half Year\",",
                "        VAR FiscalQtr =",
                "            INT(",
                "                (",
                "                    IF( MONTH( [Date] ) - 3 <= 0,",
                "                        MONTH( [Date] ) - 3 + 12,",
                "                        MONTH( [Date] ) - 3",
                "                    ) + 2",
                "                ) / 3",
                "            )",
                "        RETURN",
                "            SWITCH(",
                "                TRUE(),",
                "                FiscalQtr IN { 1, 2 }, \"H1\",",
                "                FiscalQtr IN { 3, 4 }, \"H2\"",
                "            ),",
                " ",
                "    /* Keys / labels */",
                "    \"Year-Month\", FORMAT( [Date], \"yyyy-MM\" ),",
                "    \"Fiscal Year-Month\",",
                "        \"FY\"",
                "        & RIGHT(",
                "            FORMAT(",
                "                IF( MONTH( [Date] ) >= 4, YEAR( [Date] ) + 1, YEAR( [Date] ) ),",
                "                \"0000\"",
                "            ),",
                "            2",
                "        )",
                "        & \"-\"",
                "        & FORMAT(",
                "            IF( MONTH( [Date] ) - 3 <= 0,",
                "                MONTH( [Date] ) - 3 + 12,",
                "                MONTH( [Date] ) - 3",
                "            ),",
                "            \"00\"",
                "        )",
                ")",
                " "
              ],
              "type": "calculated"
            }
          }
        ]
      },
