          "calculationItems": [
            {
              "name": "Current",
              "description": "The selected measure with no time shift applied.",
              "expression": "SELECTEDMEASURE()",
              "formatStringDefinition": {
                "expression": "SELECTEDMEASUREFORMATSTRING()"
              },
              "ordinal": 0
            },
            {
              "name": "PM",
              "description": "The selected measure for the previous month.",
              "expression": "CALCULATE(SELECTEDMEASURE(), PREVIOUSMONTH('Date table'[Date]))",
              "formatStringDefinition": {
                "expression": "SELECTEDMEASUREFORMATSTRING()"
              },
              "ordinal": 1
            },
            {
              "name": "MoM %",
              "description": "Growth of the selected measure vs the previous month. Arrow and 'vs PM' suffix come from the dynamic format string.",
              "expression": [
                "VAR Cur = SELECTEDMEASURE()",
                "VAR Prv = CALCULATE(SELECTEDMEASURE(), PREVIOUSMONTH('Date table'[Date]))",
                "RETURN",
                "    IF(",
                "        NOT ISBLANK(Cur) && NOT ISBLANK(Prv) && Prv <> 0,",
                "        DIVIDE(Cur - Prv, Prv)",
                "    )"
              ],
              "formatStringDefinition": {
                "expression": "\"▲0.00%\"\" vs PM\"\";▼0.00%\"\" vs PM\"\";▬0.00%\"\" vs PM\"\"\""
              },
              "ordinal": 2
            },
            {
              "name": "PY",
              "description": "The selected measure for the same period last year.",
              "expression": "CALCULATE(SELECTEDMEASURE(), SAMEPERIODLASTYEAR('Date table'[Date]))",
              "formatStringDefinition": {
                "expression": "SELECTEDMEASUREFORMATSTRING()"
              },
              "ordinal": 3
            },
            {
              "name": "YoY %",
              "description": "Growth of the selected measure vs the same period last year. Blank unless the full prior-year period falls within available data history.",
              "expression": [
                "VAR Cur = SELECTEDMEASURE()",
                "VAR FirstFactDate =",
                "    CALCULATE(MIN(Fact_table[invoice_date]), REMOVEFILTERS(Fact_table), REMOVEFILTERS('Date table'))",
                "VAR CurStart = MIN('Date table'[Date])",
                "VAR ExpectedPYStart = EDATE(CurStart, -12)",
                "VAR Prv = CALCULATE(SELECTEDMEASURE(), SAMEPERIODLASTYEAR('Date table'[Date]))",
                "RETURN",
                "    IF(",
                "        NOT ISBLANK(Cur)",
                "            && NOT ISBLANK(Prv)",
                "            && Prv <> 0",
                "            && ExpectedPYStart >= FirstFactDate,",
                "        DIVIDE(Cur - Prv, Prv)",
                "    )"
              ],
              "formatStringDefinition": {
                "expression": "\"▲0.00%\"\" vs PY\"\";▼0.00%\"\" vs PY\"\";▬0.00%\"\" vs PY\"\"\""
              },
              "ordinal": 4
            }
          ],
          "description": "Time intelligence calculation items. Apply to any base measure instead of creating a separate growth measure per base measure.",
          "precedence": 10
        },
        "columns": [
          {
            "name": "Time Intelligence",
            "dataType": "string",
            "lineageTag": "73b53306-c8be-4ee7-8a43-91b070a8a3bc"
          }
        ],
        "lineageTag": "fc0cb2f8-672e-4670-85e1-3878c30c26e1",
        "partitions": [
          {
            "name": "Partition_Time Intelligence",
            "source": {
              "type": "calculationGroup"
            }
          }
        ]
      }
    ]
  }
}