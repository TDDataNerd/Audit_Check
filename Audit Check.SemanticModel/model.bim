    "expressions": [
      {
        "name": "fact_invoice_raw",
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          },
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "expression": [
          "let",
          "    Source = Sql.Databases(\"tdpowerbidata-ondemand.sql.azuresynapse.net\"),",
          "    TDBIReporting = Source{[Name=\"TDBIReporting\"]}[Data],",
          "    dbo_fact_invoice = TDBIReporting{[Schema=\"dbo\",Item=\"fact_invoicess\"]}[Data],",
          "    #\"Removed Duplicates\" = Table.Distinct(dbo_fact_invoice),",
          "    #\"Replaced Value\" = Table.ReplaceValue(#\"Removed Duplicates\",null,\"NA\",Replacer.ReplaceValue,{\"customer_id\", \"delivery_mode_id\", \"payment_mode_id\", \"entity_id\", \"item_id\", \"item_group\", \"sales_id\", \"original_sales_id\", \"currency_code\", \"tax_group\", \"customer_name\", \"payment_terms\", \"delivery_name\", \"return_status\", \"sales_status\", \"sales_type\", \"salesperson_id\", \"Account_manager\", \"warehouse_id\"}),",
          "    #\"Filtered Rows3\" = Table.SelectRows(#\"Replaced Value\", each ([invoice_id] <> null)),",
          "    #\"Replaced Value2\" = Table.ReplaceValue(#\"Filtered Rows3\",null,0,Replacer.ReplaceValue,{\"cost_mst\", \"Cost_USD\"}),",
          "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Replaced Value2\",{{\"invoice_date\", type date}, {\"order_date\", type date}}),",
          "    #\"Removed Columns\" = Table.RemoveColumns(#\"Changed Type\",{\"original_sales_id\", \"tax_group\"}),",
          "    #\"Changed Type1\" = Table.TransformColumnTypes(#\"Removed Columns\",{{\"lineamount\", Currency.Type}, {\"lineamountmst\", Currency.Type}, {\"exchange_rate\", Currency.Type}, {\"Sales_USD\", Currency.Type}, {\"line_quantity\", Int64.Type}}),",
