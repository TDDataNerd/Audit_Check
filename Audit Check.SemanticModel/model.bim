            "lineageTag": "883c1616-21a7-4f0c-8f27-20cf104f2c5e"
          },
          {
            "name": "cogs_mom (%)",
            "description": "COGS change vs previous month. Blank unless exactly one calendar month is in context. Note: rising COGS is not inherently bad - read alongside revenue or margin.",
            "displayFolder": "Growth Rate",
            "expression": [
              "VAR Cur = [COGS]",
              "VAR Prv = CALCULATE([COGS], PREVIOUSMONTH('Date table'[Date]))",
              "RETURN",
              "    IF(",
              "        [Months In Context] = 1 && NOT ISBLANK(Cur) && NOT ISBLANK(Prv) && Prv <> 0,",
              "        DIVIDE(Cur - Prv, Prv)",
              "    )"
            ],
            "formatString": "▲0.00%\" vs PM\";▼0.00%\" vs PM\";▬0.00%\" vs PM\"",
            "lineageTag": "c3fac4a5-794a-4aba-96de-31a5319f2069"
          },
          {
            "name": "cogs_yoy (%)",
            "description": "COGS change vs the same period last year. Blank unless the full prior-year period falls within available history.",
            "displayFolder": "Growth Rate",
            "expression": [
              "VAR Cur = [COGS]",
              "VAR FirstFactDate =",
              "    CALCULATE(MIN(Fact_table[invoice_date]), REMOVEFILTERS(Fact_table), REMOVEFILTERS('Date table'))",
              "VAR CurStart = MIN('Date table'[Date])",
              "VAR ExpectedPYStart = EDATE(CurStart, -12)",
              "VAR Prv = CALCULATE([COGS], SAMEPERIODLASTYEAR('Date table'[Date]))",
              "RETURN",
              "    IF(",
              "        NOT ISBLANK(Cur) && NOT ISBLANK(Prv) && Prv <> 0 && ExpectedPYStart >= FirstFactDate,",
              "        DIVIDE(Cur - Prv, Prv)",
              "    )"
            ],
            "formatString": "▲0.00%\" vs PY\";▼0.00%\" vs PY\";▬0.00%\" vs PY\"",
            "lineageTag": "4e6f7a5a-08b3-4582-9056-bf1dcd34cb41"
          },
          {
            "name": "Quarters In Context",
            "description": "Count of distinct fiscal quarters in the current filter context. QoQ is only meaningful when this equals 1.",
            "displayFolder": "Card Helpers",
            "expression": "COUNTROWS(SUMMARIZE('Date table', 'Date table'[FY], 'Date table'[Fiscal Quarter]))",
            "isHidden": true,
            "lineageTag": "4c5f6370-f2bc-4a3e-b1a0-df5cf2fade1c"
          },
          {
            "name": "sales_qoq (%)",
            "description": "Revenue vs the prior fiscal quarter, compared like-for-like: only the same number of elapsed days is taken from the prior quarter. Blank unless exactly one quarter is in context and the prior window falls within available history.",
            "displayFolder": "Growth Rate",
            "expression": [
              "VAR MinD = MIN('Date table'[Date])",
              "VAR MaxD = MAX('Date table'[Date])",
              "VAR FirstSale = CALCULATE(MIN(Fact_table[invoice_date]), REMOVEFILTERS(Fact_table), REMOVEFILTERS('Date table'))",
              "VAR LastSale = CALCULATE(MAX(Fact_table[invoice_date]), REMOVEFILTERS(Fact_table), REMOVEFILTERS('Date table'))",
              "VAR EffEnd = MIN(MaxD, LastSale)",
              "VAR Days = DATEDIFF(MinD, EffEnd, DAY) + 1",
              "VAR PQStart = EDATE(MinD, -3)",
              "VAR PQEnd = MIN(PQStart + Days - 1, MinD - 1)",
              "VAR Cur = CALCULATE([Revenue], DATESBETWEEN('Date table'[Date], MinD, EffEnd))",
              "VAR Prv = CALCULATE([Revenue], DATESBETWEEN('Date table'[Date], PQStart, PQEnd))",
              "RETURN",
              "    IF(",
              "        [Quarters In Context] = 1 && PQStart >= FirstSale",
              "            && NOT ISBLANK(Cur) && NOT ISBLANK(Prv) && Prv <> 0,",
              "        DIVIDE(Cur - Prv, Prv)",
              "    )"
            ],
            "formatString": "▲0.00%\" vs PQ\";▼0.00%\" vs PQ\";▬0.00%\" vs PQ\"",
            "lineageTag": "5d914c8d-38bf-49d7-b448-bc5ff609b853"
          },
          {
            "name": "cogs_qoq (%)",
            "description": "COGS vs the prior fiscal quarter, like-for-like on elapsed days.",
            "displayFolder": "Growth Rate",
            "expression": [
              "VAR MinD = MIN('Date table'[Date])",
              "VAR MaxD = MAX('Date table'[Date])",
              "VAR FirstSale = CALCULATE(MIN(Fact_table[invoice_date]), REMOVEFILTERS(Fact_table), REMOVEFILTERS('Date table'))",
              "VAR LastSale = CALCULATE(MAX(Fact_table[invoice_date]), REMOVEFILTERS(Fact_table), REMOVEFILTERS('Date table'))",
              "VAR EffEnd = MIN(MaxD, LastSale)",
              "VAR Days = DATEDIFF(MinD, EffEnd, DAY) + 1",
              "VAR PQStart = EDATE(MinD, -3)",
              "VAR PQEnd = MIN(PQStart + Days - 1, MinD - 1)",
              "VAR Cur = CALCULATE([COGS], DATESBETWEEN('Date table'[Date], MinD, EffEnd))",
              "VAR Prv = CALCULATE([COGS], DATESBETWEEN('Date table'[Date], PQStart, PQEnd))",
              "RETURN",
              "    IF(",
              "        [Quarters In Context] = 1 && PQStart >= FirstSale",
              "            && NOT ISBLANK(Cur) && NOT ISBLANK(Prv) && Prv <> 0,",
              "        DIVIDE(Cur - Prv, Prv)",
              "    )"
            ],
            "formatString": "▲0.00%\" vs PQ\";▼0.00%\" vs PQ\";▬0.00%\" vs PQ\"",
            "lineageTag": "8cd8bd00-d854-4208-940a-5322b11656ae"
          },
          {
            "name": "orders_qoq (%)",
            "description": "Invoice count vs the prior fiscal quarter, like-for-like on elapsed days.",
            "displayFolder": "Growth Rate",
            "expression": [
              "VAR MinD = MIN('Date table'[Date])",
              "VAR MaxD = MAX('Date table'[Date])",
              "VAR FirstSale = CALCULATE(MIN(Fact_table[invoice_date]), REMOVEFILTERS(Fact_table), REMOVEFILTERS('Date table'))",
