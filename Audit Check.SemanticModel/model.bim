        ],
        "lineageTag": "6c164eaa-4a90-4160-98b9-069d5664b108",
        "partitions": [
          {
            "name": "Dim_BU",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = fact_invoice_raw,",
                "    #\"Removed Other Columns\" = Table.SelectColumns(Source,{\"item_group\"}),",
                "    #\"Uppercased Text\" = Table.TransformColumns(#\"Removed Other Columns\",{{\"item_group\", Text.Upper, type text}}),",
                "    #\"Removed Duplicates\" = Table.Distinct(#\"Uppercased Text\"),",
                "    #\"Buffered Table\" = Table.Buffer(#\"Removed Duplicates\"),",
                "    #\"Trimmed Text\" = Table.TransformColumns(#\"Buffered Table\",{{\"item_group\", Text.Trim, type text}}),",
                "    #\"Sorted Rows\" = Table.Sort(#\"Trimmed Text\",{{\"item_group\", Order.Ascending}}),",
                "    #\"Added Index\" = Table.AddIndexColumn(#\"Sorted Rows\", \"Index\", 1, 1, Int64.Type),",
                "    #\"Reordered Columns\" = Table.ReorderColumns(#\"Added Index\",{\"Index\", \"item_group\"}),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Reordered Columns\",{{\"Index\", type text}}),",
                "    #\"Renamed Columns\" = Table.RenameColumns(#\"Changed Type\",{{\"Index\", \"BU_id\"}}),",
                "    #\"Added Custom\" = Table.AddColumn(#\"Renamed Columns\", \"Business Unit\", each let",
                "    item_groupMap = [",
                "        //PSG = \"COMPUTING\",",
                "        //IPG = \"PRINT\",",
                "        //HPS = \"SUPPLIES\",",
                "        NA = \"OTHERS\",",
                "        #\"HUAWEI POW\" = \"HUAWEI POWER\",",
                "        #\"ZINOX IPOW\" = \"ZINOX IPOWER\",",
                "        SAMSUNGCOM = \"SAMSUNG COM\",",
                "        #\"SAM MOBILE\" = \"SAMSUNG MOBILE\",",
                "        #\"ZINOX COMP\" = \"ZINOX COMPUTERS\"",
                "    ],",
                "    ZinoxCE = {\"ZINOX TV\", \"ZINOX GEN\", \"ZINOX FAN\"},",
                "    SamsungCE = {\"SAM AC\", \"SAM REF\", \"SAM WAM\", \"SAM BAR\", \"SAM TV\"}",
                "in",
                "    if   List.Contains(ZinoxCE, [item_group])   then \"ZINOX CE\"",
                "    else if List.Contains(SamsungCE, [item_group]) then \"SAMSUNG CE\"",
                "    else Record.FieldOrDefault(item_groupMap, [item_group], [item_group])),",
                "    #\"Changed Type1\" = Table.TransformColumnTypes(#\"Added Custom\",{{\"Business Unit\", type text}}),",
                "    #\"Added Custom1\" = Table.AddColumn(#\"Changed Type1\", \"Business Group\", each let",
                "    groupMap = [",
                "        #\"ASUS\" = \"ALT-COMPUTING\",",
                "        #\"LENOVO\" = \"ALT-COMPUTING\",",
                "",
                "        #\"CHECKPOINT\" = \"ENTERPRISE SOLUTIONS ALPHA\",",
                "        #\"CISCO\" = \"ENTERPRISE SOLUTIONS ALPHA\",",
                "        #\"DELL\" = \"ENTERPRISE SOLUTIONS ALPHA\",",
                "        #\"DELL EMC\" = \"ENTERPRISE SOLUTIONS ALPHA\",",
                "        #\"IBM\" = \"ENTERPRISE SOLUTIONS ALPHA\",",
                "        #\"NUTANIX\" = \"ENTERPRISE SOLUTIONS ALPHA\",",
                "        #\"ZEBRA\" = \"ENTERPRISE SOLUTIONS ALPHA\",",
                "",
                "        #\"DLINK\" = \"ENTERPRISE SOLUTIONS BETA\",",
                "        #\"HPE\" = \"ENTERPRISE SOLUTIONS BETA\",",
                "        #\"HUAWEI\" = \"ENTERPRISE SOLUTIONS BETA\",",
                "        #\"HUAWEI R-R\" = \"ENTERPRISE SOLUTIONS BETA\",",
                "        #\"HUAWEI SMB\" = \"ENTERPRISE SOLUTIONS BETA\",",
                "        #\"TD SERVICE\" = \"ENTERPRISE SOLUTIONS BETA\",",
                "",
                "        #\"APC\" = \"MAINSTREAM\",",
                "        #\"ECOFLOW\" = \"MAINSTREAM\",",
                "        #\"HPS\" = \"MAINSTREAM\",",
                "        #\"HUAWEI POWER\" = \"MAINSTREAM\",",
                "        #\"IPG\" = \"MAINSTREAM\",",
                "        #\"PSG\" = \"MAINSTREAM\",",
                "        #\"ZINOX COMPUTERS\" = \"MAINSTREAM\",",
                "        #\"ZINOX IPOWER\" = \"MAINSTREAM\",",
                "",
                "        #\"GENERAL ACCESSORIES\" = \"MOBILE\",",
                "        #\"HUAWEI PHONE\" = \"MOBILE\",",
                "        #\"INFINIX\" = \"MOBILE\",",
                "        #\"NOKIA\" = \"MOBILE\",",
                "        #\"OPPO\" = \"MOBILE\",",
                "        #\"SAMSUNG MOBILE\" = \"MOBILE\",",
                "        #\"TECNO\" = \"MOBILE\",",
                "        #\"ZTE\" = \"MOBILE\",",
                "        #\"MIGO\" = \"MOBILE\",",
                "        #\"MKOPA-UK\" = \"MOBILE\",",
                "",
                "        #\"BOSCH\" = \"MODERN LIFESTYLE SOLUTIONS\",",
                "        #\"LG\" = \"MODERN LIFESTYLE SOLUTIONS\",",
                "        #\"PHILIPS\" = \"MODERN LIFESTYLE SOLUTIONS\",",
                "        #\"SAMSUNG CE\" = \"MODERN LIFESTYLE SOLUTIONS\",",
                "        #\"SAMSUNG COM\" = \"MODERN LIFESTYLE SOLUTIONS\",",
                "        #\"STARLINK\" = \"MODERN LIFESTYLE SOLUTIONS\",",
                "        #\"SYINIX\" = \"MODERN LIFESTYLE SOLUTIONS\",",
                "        #\"ZINOX CE\" = \"MODERN LIFESTYLE SOLUTIONS\",",
                "",
                "        #\"MICROSOFT\" = \"SOFTWARE\"",
                "    ]",
                "in",
                "    Record.FieldOrDefault(groupMap, [Business Unit], \"OTHERS\")),",
                "    #\"Sorted Rows1\" = Table.Sort(#\"Added Custom1\",{{\"item_group\", Order.Ascending}}),",
                "    #\"Replaced Value\" = Table.ReplaceValue(#\"Sorted Rows1\",\"HUAWEI PHO\",\"HUAWEI PHONE\",Replacer.ReplaceText,{\"Business Unit\"})",
                "in",
                "    #\"Replaced Value\""
              ],
              "type": "m"
            }
          }
        ]
      },
