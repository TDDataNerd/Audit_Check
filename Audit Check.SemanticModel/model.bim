          {
            "name": "Active Customers",
            "description": "Distinct customers with at least one invoice line in the current context. Uses the fact's own customer_id rather than the Dim_Customer key, so it is unaffected by the cus_id join problem.",
            "displayFolder": "Base Measure",
            "expression": "DISTINCTCOUNT(Fact_table[customer_id])",
            "formatString": "#,0",
            "lineageTag": "975ec416-10ce-4637-91e0-11579397cf0b"
          },
          {
            "name": "Average Order Value",
            "description": "Revenue divided by distinct invoices. This is average invoice value. Note: [Avg Revenue] averages invoice LINES, which is a different and much smaller figure.",
            "displayFolder": "Base Measure",
            "expression": "DIVIDE([Revenue], DISTINCTCOUNT(Fact_table[invoice_id]))",
            "formatString": "\\$#,0.00",
            "lineageTag": "4822dd34-5476-42e5-95e7-53dcf02cd742"
          },
          {
            "name": "customers_mom (%)",
            "description": "Active customer growth vs previous month. Blank unless exactly one calendar month is in context.",
            "displayFolder": "Growth Rate",
            "expression": [
              "VAR Cur = [Active Customers]",
              "VAR Prv = CALCULATE([Active Customers], PREVIOUSMONTH('Date table'[Date]))",
              "RETURN IF([Months In Context] = 1 && NOT ISBLANK(Cur) && NOT ISBLANK(Prv) && Prv <> 0, DIVIDE(Cur - Prv, Prv))"
            ],
            "formatString": "▲0.00%\" vs PM\";▼0.00%\" vs PM\";▬0.00%\" vs PM\"",
            "lineageTag": "2e653295-f835-4d94-ae7c-ee6278054758"
          },
          {
            "name": "customers_yoy (%)",
            "description": "Active customer growth vs the same period last year. Blank unless the full prior-year period falls within available history.",
            "displayFolder": "Growth Rate",
            "expression": [
              "VAR Cur = [Active Customers]",
              "VAR FirstFactDate =",
              "    CALCULATE(MIN(Fact_table[invoice_date]), REMOVEFILTERS(Fact_table), REMOVEFILTERS('Date table'))",
              "VAR CurStart = MIN('Date table'[Date])",
              "VAR ExpectedPYStart = EDATE(CurStart, -12)",
              "VAR Prv = CALCULATE([Active Customers], SAMEPERIODLASTYEAR('Date table'[Date]))",
              "RETURN",
              "    IF(",
              "        NOT ISBLANK(Cur)",
              "            && NOT ISBLANK(Prv)",
              "            && Prv <> 0",
              "            && ExpectedPYStart >= FirstFactDate,",
              "        DIVIDE(Cur - Prv, Prv)",
              "    )"
            ],
            "formatString": "▲0.00%\" vs PY\";▼0.00%\" vs PY\";▬0.00%\" vs PY\"",
            "lineageTag": "fa97d54d-5004-440d-84a5-b1c498f525dc"
          },
          {
            "name": "aov_mom (%)",
            "description": "Average order value growth vs previous month. Blank unless exactly one calendar month is in context.",
            "displayFolder": "Growth Rate",
            "expression": [
              "VAR Cur = [Average Order Value]",
              "VAR Prv = CALCULATE([Average Order Value], PREVIOUSMONTH('Date table'[Date]))",
              "RETURN IF([Months In Context] = 1 && NOT ISBLANK(Cur) && NOT ISBLANK(Prv) && Prv <> 0, DIVIDE(Cur - Prv, Prv))"
            ],
            "formatString": "▲0.00%\" vs PM\";▼0.00%\" vs PM\";▬0.00%\" vs PM\"",
            "lineageTag": "eafcd9f9-165d-4c89-9ac9-17d9c4476a2a"
          },
          {
            "name": "aov_yoy (%)",
            "description": "Average order value growth vs the same period last year. Blank unless the full prior-year period falls within available history.",
            "displayFolder": "Growth Rate",
            "expression": [
              "VAR Cur = [Average Order Value]",
              "VAR FirstFactDate =",
              "    CALCULATE(MIN(Fact_table[invoice_date]), REMOVEFILTERS(Fact_table), REMOVEFILTERS('Date table'))",
              "VAR CurStart = MIN('Date table'[Date])",
              "VAR ExpectedPYStart = EDATE(CurStart, -12)",
              "VAR Prv = CALCULATE([Average Order Value], SAMEPERIODLASTYEAR('Date table'[Date]))",
              "RETURN",
              "    IF(",
              "        NOT ISBLANK(Cur)",
              "            && NOT ISBLANK(Prv)",
              "            && Prv <> 0",
              "            && ExpectedPYStart >= FirstFactDate,",
              "        DIVIDE(Cur - Prv, Prv)",
              "    )"
            ],
            "formatString": "▲0.00%\" vs PY\";▼0.00%\" vs PY\";▬0.00%\" vs PY\"",
            "lineageTag": "76697d1a-f400-4641-999f-55ef74d21c27"
          },
          {
            "name": "margin_mom (pts)",
            "description": "Gross margin change vs previous month, in percentage points. Blank unless exactly one calendar month is in context.",
            "displayFolder": "Growth Rate",
            "expression": [
              "VAR Cur = [Profit Margin (%)]",
              "VAR Prv = CALCULATE([Profit Margin (%)], PREVIOUSMONTH('Date table'[Date]))",
              "RETURN IF([Months In Context] = 1 && NOT ISBLANK(Cur) && NOT ISBLANK(Prv), Cur - Prv)"
            ],
            "formatString": "▲0.00%\" pts vs PM\";▼0.00%\" pts vs PM\";▬0.00%\" pts vs PM\"",
            "lineageTag": "fa51e8e7-979c-4fd3-bfca-d2927acad693"
          },
          {
            "name": "customers_mom_colour",
            "description": "Hex colour for [customers_mom (%)].",
            "displayFolder": "Formatting",
            "expression": [
              "VAR v = [customers_mom (%)]",
              "RETURN",
              "    SWITCH(TRUE(), ISBLANK(v), \"#605E5C\", v > 0, \"#107C10\", v < 0, \"#D13438\", \"#000000\")"
            ],
