        "measures": [
          {
            "name": "Avg Revenue",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ],
            "displayFolder": "Base Measure",
            "expression": "AVERAGE(Fact_table[Sales_USD])",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "2974d9d8-a53e-4c23-8ec7-2c70bcdfd874"
          },
          {
            "name": "Count of Invoice ID",
            "displayFolder": "Base Measure",
            "expression": "DISTINCTCOUNT(fact_table[invoice_id])",
            "formatString": "#,0.00",
            "lineageTag": "8ab8e50b-af34-4230-a1c6-65131bcb353d"
          },
          {
            "name": "sales_mom (%)",
            "description": "Revenue growth vs previous month. Blank unless exactly one calendar month is in context, since comparing a multi-month window to a single prior month is not a like-for-like comparison. Use [Revenue Growth %] for grain-agnostic comparison.",
            "displayFolder": "Growth Rate",
            "expression": [
              "VAR Cur = [Revenue]",
              "VAR Prv = CALCULATE([Revenue], PREVIOUSMONTH('Date table'[Date]))",
              "RETURN",
              "    IF(",
              "        [Months In Context] = 1",
              "            && NOT ISBLANK(Cur)",
              "            && NOT ISBLANK(Prv)",
              "            && Prv <> 0,",
              "        DIVIDE(Cur - Prv, Prv)",
              "    )"
            ],
            "formatString": "▲0.00%\" vs PM\";▼0.00%\" vs PM\";▬0.00%\" vs PM\"",
            "lineageTag": "5db16c55-da16-4b26-ac1c-0febd40709e3"
          },
          {
            "name": "Revenue",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ],
            "displayFolder": "Base Measure",
            "expression": "SUM(Fact_table[Sales_USD])",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "006637d8-bcea-43ac-949d-c8fd44502696"
          },
          {
            "name": "Sales Volume",
            "displayFolder": "Base Measure",
            "expression": "SUM(Fact_table[line_quantity])",
            "formatString": "#,0.00",
            "lineageTag": "a6f46963-ee79-4fcf-9720-2d05d48f3b42"
          },
          {
            "name": "sales_yoy (%)",
            "description": "Revenue growth vs the same period last year. Blank unless the full prior-year period falls within the available data history, so partial-overlap comparisons are suppressed. Starts returning values automatically once a year of history exists.",
            "displayFolder": "Growth Rate",
            "expression": [
              "VAR Cur = [Revenue]",
              "VAR FirstFactDate =",
              "    CALCULATE(MIN(Fact_table[invoice_date]), REMOVEFILTERS(Fact_table), REMOVEFILTERS('Date table'))",
              "VAR CurStart = MIN('Date table'[Date])",
              "VAR ExpectedPYStart = EDATE(CurStart, -12)",
              "VAR Prv = CALCULATE([Revenue], SAMEPERIODLASTYEAR('Date table'[Date]))",
              "RETURN",
              "    IF(",
              "        NOT ISBLANK(Cur)",
              "            && NOT ISBLANK(Prv)",
              "            && Prv <> 0",
              "            && ExpectedPYStart >= FirstFactDate,",
              "        DIVIDE(Cur - Prv, Prv)",
              "    )"
            ],
            "formatString": "▲0.00%\" vs PY\";▼0.00%\" vs PY\";▬0.00%\" vs PY\"",
            "lineageTag": "8498198b-705c-4e9c-ab7f-653ccf1ed427"
          },
          {
            "name": "Bar Color",
            "displayFolder": "Others",
            "expression": [
              "",
              "IF(",
              "    [Revenue] < 0,",
              "    \"#E81123\",",
              "    \"#8F3030\"",
              ")"
            ],
            "lineageTag": "5cf0ec07-1828-4bce-9fd0-658059dc0443"
          },
          {
            "name": "volume_mom (%)",
            "description": "Sales volume growth vs previous month. Blank unless exactly one calendar month is in context.",
            "displayFolder": "Growth Rate",
            "expression": [
              "VAR Cur = [Sales Volume]",
              "VAR Prv = CALCULATE([Sales Volume], PREVIOUSMONTH('Date table'[Date]))",
              "RETURN IF([Months In Context] = 1 && NOT ISBLANK(Cur) && NOT ISBLANK(Prv) && Prv <> 0, DIVIDE(Cur - Prv, Prv))"
            ],
            "formatString": "▲0.00%\" vs PM\";▼0.00%\" vs PM\";▬0.00%\" vs PM\"",
            "lineageTag": "8669dbdd-5801-4ad7-a2a9-f2c542146eac"
