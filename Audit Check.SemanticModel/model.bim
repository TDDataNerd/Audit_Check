            ],
            "formatString": "▲0.00%\" vs PQ\";▼0.00%\" vs PQ\";▬0.00%\" vs PQ\"",
            "lineageTag": "46e13c05-b475-4733-8dc8-3df681fbdcae"
          },
          {
            "name": "avg_revenue_qoq (%)",
            "description": "Average line revenue vs the prior fiscal quarter, like-for-like on elapsed days.",
            "displayFolder": "Growth Rate",
            "expression": [
              "VAR MinD = MIN('Date table'[Date])",
              "VAR MaxD = MAX('Date table'[Date])",
              "VAR FirstSale = CALCULATE(MIN(Fact_table[invoice_date]), REMOVEFILTERS(Fact_table), REMOVEFILTERS('Date table'))",
              "VAR LastSale = CALCULATE(MAX(Fact_table[invoice_date]), REMOVEFILTERS(Fact_table), REMOVEFILTERS('Date table'))",
              "VAR EffEnd = MIN(MaxD, LastSale)",
              "VAR Days = DATEDIFF(MinD, EffEnd, DAY) + 1",
              "VAR PQStart = EDATE(MinD, -3)",
              "VAR PQEnd = MIN(PQStart + Days - 1, MinD - 1)",
              "VAR Cur = CALCULATE([Avg Revenue], DATESBETWEEN('Date table'[Date], MinD, EffEnd))",
              "VAR Prv = CALCULATE([Avg Revenue], DATESBETWEEN('Date table'[Date], PQStart, PQEnd))",
              "RETURN",
              "    IF(",
              "        [Quarters In Context] = 1 && PQStart >= FirstSale",
              "            && NOT ISBLANK(Cur) && NOT ISBLANK(Prv) && Prv <> 0,",
