              "VAR ValTxt = FORMAT(Val, \"0.00%\")",
              "VAR MTxt = IF(ISBLANK(M), \"-- vs PM\", UNICHAR(IF(M >= 0, 9650, 9660)) & FORMAT(ABS(M), \"0.00%\") & \" pts vs PM\")",
              "VAR MCol = IF(ISBLANK(M), Grey, IF(M >= 0, Green, Red))",
              "VAR QTxt = IF(ISBLANK(Q), \"-- vs PQ\", UNICHAR(IF(Q >= 0, 9650, 9660)) & FORMAT(ABS(Q), \"0.00%\") & \" pts vs PQ\")",
