        "partitions": [
          {
            "name": "Dim_Customer",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Sql.Databases(\"tdpowerbidata-ondemand.sql.azuresynapse.net\"),",
                "    TDBIReporting = Source{[Name=\"TDBIReporting\"]}[Data],",
                "    dbo_Customers_view = TDBIReporting{[Schema=\"dbo\",Item=\"Customers_view\"]}[Data],",
                "    #\"Removed Other Columns\" = Table.SelectColumns(dbo_Customers_view,{\"accountnum\", \"dataareaid\", \"name\"}),",
                "    #\"Uppercased Text1\" = Table.TransformColumns(#\"Removed Other Columns\",{{\"dataareaid\", Text.Upper, type text}}),",
                "    #\"Added Custom\" = Table.AddColumn(#\"Uppercased Text1\", \"Custom\", each [accountnum] & \"-\" & [dataareaid]),",
                "    #\"Removed Duplicates\" = Table.Distinct(#\"Added Custom\", {\"Custom\"}),",
                "    #\"Renamed Columns\" = Table.RenameColumns(#\"Removed Duplicates\",{{\"accountnum\", \"customer_id\"}, {\"name\", \"customer_name\"}, {\"Custom\", \"combined\"}}),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Renamed Columns\",{{\"combined\", type text}}),",
                "    #\"Trimmed Text\" = Table.TransformColumns(#\"Changed Type\",{{\"customer_name\", Text.Trim, type text}}),",
                "    #\"Sorted Rows\" = Table.Sort(#\"Trimmed Text\",{{\"combined\", Order.Ascending}}),",
                "    #\"Uppercased Text\" = Table.TransformColumns(#\"Sorted Rows\",{{\"customer_name\", Text.Upper, type text}}),",
                "    #\"Filtered Rows1\" = Table.SelectRows(#\"Uppercased Text\", each ([customer_id] <> null)),",
                "    #\"Removed Columns\" = Table.RemoveColumns(#\"Filtered Rows1\",{\"dataareaid\"}),",
                "    #\"Reordered Columns\" = Table.ReorderColumns(#\"Removed Columns\",{\"combined\", \"customer_name\"}),",
                "    #\"Renamed Columns1\" = Table.RenameColumns(#\"Reordered Columns\",{{\"combined\", \"customerId\"}})",
                "in",
                "    #\"Renamed Columns1\""
              ],
              "type": "m"
            }
          }
        ]
      },
