          {
            "name": "margin_mom_colour",
            "description": "Hex colour for [margin_mom (pts)].",
            "displayFolder": "Formatting",
            "expression": [
              "VAR v = [margin_mom (pts)]",
              "RETURN",
              "    SWITCH(TRUE(), ISBLANK(v), \"#605E5C\", v > 0, \"#107C10\", v < 0, \"#D13438\", \"#000000\")"
            ],
            "isHidden": true,
            "lineageTag": "c974e1c0-a79e-4b07-aedf-a6aab7cd55d3"
          },
          {
            "name": "margin_yoy (pts)",
            "description": "Gross margin change vs the same period last year, in percentage points. Blank unless the full prior-year period falls within available history.",
            "displayFolder": "Growth Rate",
            "expression": [
              "VAR Cur = [Profit Margin (%)]",
              "VAR FirstFactDate =",
              "    CALCULATE(MIN(Fact_table[invoice_date]), REMOVEFILTERS(Fact_table), REMOVEFILTERS('Date table'))",
              "VAR CurStart = MIN('Date table'[Date])",
              "VAR ExpectedPYStart = EDATE(CurStart, -12)",
              "VAR Prv = CALCULATE([Profit Margin (%)], SAMEPERIODLASTYEAR('Date table'[Date]))",
              "RETURN",
              "    IF(",
              "        NOT ISBLANK(Cur)",
              "            && NOT ISBLANK(Prv)",
              "            && ExpectedPYStart >= FirstFactDate,",
              "        Cur - Prv",
              "    )"
            ],
            "formatString": "▲0.00%\" pts vs PY\";▼0.00%\" pts vs PY\";▬0.00%\" pts vs PY\"",
            "lineageTag": "84e5cbd9-4760-4301-80f8-381ea556fa4c"
          },
          {
            "name": "margin_yoy_colour",
            "description": "Hex colour for [margin_yoy (pts)].",
            "displayFolder": "Formatting",
            "expression": [
              "VAR v = [margin_yoy (pts)]",
              "RETURN",
              "    SWITCH(TRUE(), ISBLANK(v), \"#605E5C\", v > 0, \"#107C10\", v < 0, \"#D13438\", \"#000000\")"
            ],
            "isHidden": true,
            "lineageTag": "514cd219-c010-4f73-8e24-b78b5c8045ee"
          },
          {
            "name": "COGS Ratio (%)",
            "description": "COGS as a share of revenue. The inverse of [Profit Margin (%)]; use where a cost ratio reads more naturally than a margin.",
            "displayFolder": "Base Measure",
            "expression": "DIVIDE([COGS], [Revenue])",
            "formatString": "0.00%",
            "lineageTag": "27264a19-6b2e-4b11-940c-97025a2acda7"
          },
          {
            "name": "Date Selection Active",
            "description": "TRUE when the user has narrowed the date context below the full calendar. Used by card measures to word the prior-period line correctly.",
            "displayFolder": "Card Helpers",
            "expression": "COUNTROWS('Date table') < COUNTROWS(ALL('Date table'))",
            "isHidden": true,
            "lineageTag": "ff7c75d4-c24f-4c59-af39-dcdae5e32701"
          },
          {
            "name": "Period Label",
            "description": "Label for the visible date window, e.g. '01 Apr - 08 Oct 2026'.",
            "displayFolder": "Card Helpers",
            "expression": [
              "VAR MinD = MIN('Date table'[Date])",
              "VAR MaxD = MAX('Date table'[Date])",
              "RETURN",
              "    IF(",
              "        MinD = MaxD,",
              "        FORMAT(MinD, \"dd MMM yyyy\"),",
              "        FORMAT(MinD, \"dd MMM\") & \" - \" & FORMAT(MaxD, \"dd MMM yyyy\")",
              "    )"
            ],
            "isHidden": true,
            "lineageTag": "c222a122-5b31-4042-9cb1-9ea8a9f250f3"
          },
          {
            "name": "PP Window Label",
            "description": "Label for the prior equal-length window immediately before the visible one.",
            "displayFolder": "Card Helpers",
            "expression": [
              "VAR MinD = MIN('Date table'[Date])",
              "VAR MaxD = MAX('Date table'[Date])",
              "VAR Len = DATEDIFF(MinD, MaxD, DAY) + 1",
              "VAR PPEnd = MinD - 1",
              "VAR PPStart = PPEnd - Len + 1",
              "RETURN FORMAT(PPStart, \"dd MMM\") & \" - \" & FORMAT(PPEnd, \"dd MMM\")"
            ],
            "isHidden": true,
            "lineageTag": "d39eaf19-e136-42c3-b5e8-e7a4dd65fb8a"
          },
          {
            "name": "Revenue Growth %",
            "description": "Revenue growth vs the prior equal-length window. Grain-agnostic: works for a 3-day or 6-week selection, unlike calendar MoM.",
            "displayFolder": "Card Helpers",
            "expression": [
              "VAR MinD = MIN('Date table'[Date])",
              "VAR MaxD = MAX('Date table'[Date])",
              "VAR Len = DATEDIFF(MinD, MaxD, DAY) + 1",
              "VAR PPEnd = MinD - 1",
              "VAR PPStart = PPEnd - Len + 1",
              "VAR Cur = [Revenue]",
              "VAR Prv = CALCULATE([Revenue], DATESBETWEEN('Date table'[Date], PPStart, PPEnd))",
              "RETURN",
              "    IF(NOT ISBLANK(Cur) && NOT ISBLANK(Prv) && Prv <> 0, DIVIDE(Cur - Prv, Prv))"
            ],
            "isHidden": true,
            "lineageTag": "b8250ef9-23ea-4de5-b91e-50eb81ec9e46"
          },
          {
            "name": "Months In Context",
            "description": "Count of distinct calendar months in the current filter context. Calendar MoM is only meaningful when this equals 1.",
            "displayFolder": "Card Helpers",
            "expression": "COUNTROWS(SUMMARIZE('Date table', 'Date table'[Year], 'Date table'[Month]))",
            "isHidden": true,
            "lineageTag": "e4dbe162-5eb7-4c42-8230-d5e0a19f32f8"
          },
          {
            "name": "Orders Label",
            "description": "Orders and customers caption for the card context row.",
            "displayFolder": "Card Helpers",
            "expression": "FORMAT([Count of Invoice ID], \"#,0\") & \" orders · \" & FORMAT([Active Customers], \"#,0\") & \" customers\"",
            "isHidden": true,
            "lineageTag": "8455f82b-60d7-427c-9fa0-89484efbb180"
          },
          {
            "name": "KPI Card - Sales",
            "dataCategory": "ImageUrl",
            "description": "SVG KPI card for Sales. Data category is ImageUrl: render with an IMAGE, TABLE or MATRIX visual at 375x207, NOT a Card visual. Rows: title, headline, prior equal-length window growth, calendar MoM/YoY, context, sparkline.",
            "displayFolder": "KPI Cards",
            "expression": [
              "VAR W = 380",
              "VAR H = 210",
              "VAR SpkTop = 158",
              "VAR SpkBot = 206",
              "",
              "VAR Val = [Revenue]",
              "VAR G = [Revenue Growth %]",
              "VAR MoM = [sales_mom (%)]",
              "VAR YoY = [sales_yoy (%)]",
              "VAR PPLbl = [PP Window Label]",
              "VAR HasSel = [Date Selection Active]",
              "",
              "VAR Pts =",
              "    FILTER(",
              "        ADDCOLUMNS(VALUES('Date table'[Date]), \"@v\", [Revenue]),",
              "        NOT ISBLANK([@v])",
              "    )",
              "VAR N = COUNTROWS(Pts)",
              "VAR MaxV = MAXX(Pts, [@v])",
              "VAR MinV = MINX(Pts, [@v])",
              "VAR Rk = ADDCOLUMNS(Pts, \"@i\", RANKX(Pts, 'Date table'[Date], , ASC, DENSE))",
              "VAR Pline =",
              "    CONCATENATEX(",
              "        Rk,",
              "        FORMAT(DIVIDE([@i] - 1, MAX(N - 1, 1)) * W, \"0.0\") & \",\" &",
              "        FORMAT(SpkBot - DIVIDE([@v] - MinV, MAX(MaxV - MinV, 1)) * (SpkBot - SpkTop), \"0.0\"),",
              "        \" \",",
              "        [@i], ASC",
              "    )",
              "",
              "VAR ValTxt =",
              "    IF(Val >= 1000000000, FORMAT(Val / 1000000000, \"#,0.00\") & \"bn\",",
              "    IF(Val >= 1000000, FORMAT(Val / 1000000, \"#,0.00\") & \"m\",",
              "    IF(Val >= 1000, FORMAT(Val / 1000, \"#,0.0\") & \"k\",",
              "        FORMAT(Val, \"#,0\"))))",
              "",
              "VAR Up = NOT ISBLANK(G) && G >= 0",
              "VAR DeltaTxt =",
              "    SWITCH(",
              "        TRUE(),",
              "        NOT ISBLANK(G),",
              "            UNICHAR(IF(Up, 9650, 9660)) & \" \" & FORMAT(ABS(G), \"0.0%\") & \" vs \" & PPLbl,",
              "        NOT HasSel,",
              "            \"all dates \" & UNICHAR(183) & \" pick a period to compare\",",
              "        \"no sales in \" & PPLbl",
              "    )",
              "VAR DeltaCol =",
              "    SWITCH(",
              "        TRUE(),",
              "        ISBLANK(G), \"rgb(110,105,101)\",",
              "        Up, \"rgb(27,107,27)\",",
              "        \"rgb(196,48,43)\"",
              "    )",
              "",
              "VAR Grey = \"rgb(120,115,111)\"",
              "VAR MoMTxt = IF(ISBLANK(MoM), \"n/a\", UNICHAR(IF(MoM >= 0, 9650, 9660)) & \" \" & FORMAT(ABS(MoM), \"0.0%\"))",
              "VAR MoMCol = IF(ISBLANK(MoM), Grey, IF(MoM >= 0, \"rgb(27,107,27)\", \"rgb(196,48,43)\"))",
              "VAR YoYTxt = IF(ISBLANK(YoY), \"n/a\", UNICHAR(IF(YoY >= 0, 9650, 9660)) & \" \" & FORMAT(ABS(YoY), \"0.0%\"))",
              "VAR YoYCol = IF(ISBLANK(YoY), Grey, IF(YoY >= 0, \"rgb(27,107,27)\", \"rgb(196,48,43)\"))",
              "",
              "RETURN",
              "IF(ISBLANK(Val), BLANK(),",
              "    \"data:image/svg+xml;utf8,\" &",
              "    \"<svg xmlns='http://www.w3.org/2000/svg' width='\" & W & \"' height='\" & H & \"' viewBox='0 0 \" & W & \" \" & H & \"'>\" &",
              "    \"<rect x='0' y='0' width='\" & W & \"' height='\" & H & \"' rx='6' fill='rgb(255,255,255)'/>\" &",
              "    \"<text x='18' y='28' font-family='Segoe UI' font-size='12' font-weight='700' letter-spacing='0.9' fill='rgb(110,105,101)'>SALES</text>\" &",
              "    \"<text x='18' y='76' font-family='Segoe UI' font-size='36' font-weight='600' fill='rgb(18,16,15)'>$\" & ValTxt & \"</text>\" &",
              "    \"<text x='18' y='104' font-family='Segoe UI' font-size='13.5' font-weight='600' fill='\" & DeltaCol & \"'>\" & DeltaTxt & \"</text>\" &",
              "    \"<text x='18' y='125' font-family='Segoe UI' font-size='12.5'>\" &",
              "        \"<tspan fill='\" & Grey & \"'>MoM </tspan>\" &",
              "        \"<tspan fill='\" & MoMCol & \"' font-weight='600'>\" & MoMTxt & \"</tspan>\" &",
              "        \"<tspan fill='\" & Grey & \"'> \" & UNICHAR(183) & \" YoY </tspan>\" &",
              "        \"<tspan fill='\" & YoYCol & \"' font-weight='600'>\" & YoYTxt & \"</tspan>\" &",
              "    \"</text>\" &",
              "    \"<text x='18' y='145' font-family='Segoe UI' font-size='12' fill='rgb(74,70,67)'>\" & [Orders Label] & \" \" & UNICHAR(183) & \" \" & [Period Label] & \"</text>\" &",
              "    IF(N > 1,",
              "        \"<polygon points='0,\" & H & \" \" & Pline & \" \" & W & \",\" & H & \"' fill='rgb(143,48,48)' opacity='0.13'/>\" &",
              "        \"<polyline points='\" & Pline & \"' fill='none' stroke='rgb(143,48,48)' stroke-width='2' stroke-linejoin='round'/>\",",
              "        \"\") &",
              "    \"</svg>\")"
            ],
            "lineageTag": "ef1cabe9-4d22-4d74-8eb6-077f0ed67670"
          },
          {
            "name": "KPI Spark - Sales",
            "dataCategory": "ImageUrl",
            "description": "Option 1 sparkline card for Sales. ImageUrl: render in an IMAGE, TABLE or MATRIX visual at 362x165, not a Card visual. Deltas stack right: PM, PQ, PY.",
            "displayFolder": "KPI Cards",
            "expression": [
              "VAR W = 362",
              "VAR H = 165",
              "VAR SpkTop = 112",
              "VAR SpkBot = 161",
              "VAR Line = \"rgb(143,48,48)\"",
              "VAR Grey = \"rgb(120,115,111)\"",
              "VAR Val = [Revenue]",
              "VAR M = [sales_mom (%)]",
              "VAR Q = [sales_qoq (%)]",
              "VAR Y = [sales_yoy (%)]",
              "VAR Pts = FILTER(ADDCOLUMNS(VALUES('Date table'[Month]), \"@v\", [Revenue]), NOT ISBLANK([@v]))",
              "VAR N = COUNTROWS(Pts)",
              "VAR MaxV = MAXX(Pts, [@v])",
              "VAR MinV = MINX(Pts, [@v])",
              "VAR Rk = ADDCOLUMNS(Pts, \"@i\", RANKX(Pts, 'Date table'[Month], , ASC, DENSE))",
              "VAR Pline = CONCATENATEX(Rk, FORMAT(DIVIDE([@i] - 1, MAX(N - 1, 1)) * W, \"0.0\") & \",\" & FORMAT(SpkBot - DIVIDE([@v] - MinV, MAX(MaxV - MinV, 1)) * (SpkBot - SpkTop), \"0.0\"), \" \", [@i], ASC)",
              "VAR ValTxt = IF(Val >= 1000000000, FORMAT(Val / 1000000000, \"#,0.00\") & \"bn\", IF(Val >= 1000000, FORMAT(Val / 1000000, \"#,0.00\") & \"m\", IF(Val >= 1000, FORMAT(Val / 1000, \"#,0.0\") & \"k\", FORMAT(Val, \"#,0\"))))",
              "VAR MTxt = IF(ISBLANK(M), \"-- vs PM\", UNICHAR(IF(M >= 0, 9650, 9660)) & FORMAT(ABS(M), \"0.00%\") & \" vs PM\")",
              "VAR MCol = IF(ISBLANK(M), Grey, IF(M >= 0, \"rgb(27,107,27)\", \"rgb(196,48,43)\"))",
              "VAR QTxt = IF(ISBLANK(Q), \"-- vs PQ\", UNICHAR(IF(Q >= 0, 9650, 9660)) & FORMAT(ABS(Q), \"0.00%\") & \" vs PQ\")",
              "VAR QCol = IF(ISBLANK(Q), Grey, IF(Q >= 0, \"rgb(27,107,27)\", \"rgb(196,48,43)\"))",
              "VAR YTxt = IF(ISBLANK(Y), \"-- vs PY\", UNICHAR(IF(Y >= 0, 9650, 9660)) & FORMAT(ABS(Y), \"0.00%\") & \" vs PY\")",
              "VAR YCol = IF(ISBLANK(Y), Grey, IF(Y >= 0, \"rgb(27,107,27)\", \"rgb(196,48,43)\"))",
              "RETURN",
              "IF(ISBLANK(Val), BLANK(),",
              "    \"data:image/svg+xml;utf8,\" &",
              "    \"<svg xmlns='http://www.w3.org/2000/svg' width='\" & W & \"' height='\" & H & \"' viewBox='0 0 \" & W & \" \" & H & \"'>\" &",
              "    \"<rect x='0' y='0' width='\" & W & \"' height='\" & H & \"' rx='8' fill='rgb(255,255,255)'/>\" &",
              "    \"<text x='18' y='28' font-family='Segoe UI' font-size='15' font-weight='700' letter-spacing='0.8' fill='rgb(90,86,82)'>SALES</text>\" &",
              "    \"<text x='18' y='84' font-family='Segoe UI' font-size='38' font-weight='600' fill='rgb(18,16,15)'>$\" & ValTxt & \"</text>\" &",
              "    \"<text x='344' y='46' text-anchor='end' font-family='Segoe UI' font-size='14' font-weight='600' fill='\" & MCol & \"'>\" & MTxt & \"</text>\" &",
              "    \"<text x='344' y='68' text-anchor='end' font-family='Segoe UI' font-size='14' font-weight='600' fill='\" & QCol & \"'>\" & QTxt & \"</text>\" &",
              "    \"<text x='344' y='90' text-anchor='end' font-family='Segoe UI' font-size='14' font-weight='600' fill='\" & YCol & \"'>\" & YTxt & \"</text>\" &",
              "    IF(N > 1, \"<polygon points='0,\" & H & \" \" & Pline & \" \" & W & \",\" & H & \"' fill='\" & Line & \"' opacity='0.13'/>\" & \"<polyline points='\" & Pline & \"' fill='none' stroke='\" & Line & \"' stroke-width='2' stroke-linejoin='round'/>\", \"\") &",
              "    \"</svg>\")"
            ],
            "lineageTag": "aca8dd68-8b1b-4ea6-8717-ba9d0d59bf5a"
          },
          {
            "name": "KPI Spark - COGS",
            "dataCategory": "ImageUrl",
            "description": "Option 1 sparkline card for Cost of Goods Sold. ImageUrl: render at 362x165. Colour logic inverted - rising COGS shows red. Figures wrong until the TDNGCI-168846 cost row is corrected.",
            "displayFolder": "KPI Cards",
            "expression": [
              "VAR W = 362",
              "VAR H = 165",
              "VAR SpkTop = 112",
              "VAR SpkBot = 161",
              "VAR Line = \"rgb(143,48,48)\"",
              "VAR Grey = \"rgb(120,115,111)\"",
              "VAR Val = [COGS]",
              "VAR M = [cogs_mom (%)]",
              "VAR Q = [cogs_qoq (%)]",
              "VAR Y = [cogs_yoy (%)]",
              "VAR Pts = FILTER(ADDCOLUMNS(VALUES('Date table'[Month]), \"@v\", [COGS]), NOT ISBLANK([@v]))",
              "VAR N = COUNTROWS(Pts)",
              "VAR MaxV = MAXX(Pts, [@v])",
              "VAR MinV = MINX(Pts, [@v])",
              "VAR Rk = ADDCOLUMNS(Pts, \"@i\", RANKX(Pts, 'Date table'[Month], , ASC, DENSE))",
              "VAR Pline = CONCATENATEX(Rk, FORMAT(DIVIDE([@i] - 1, MAX(N - 1, 1)) * W, \"0.0\") & \",\" & FORMAT(SpkBot - DIVIDE([@v] - MinV, MAX(MaxV - MinV, 1)) * (SpkBot - SpkTop), \"0.0\"), \" \", [@i], ASC)",
              "VAR ValTxt = IF(Val >= 1000000000, FORMAT(Val / 1000000000, \"#,0.00\") & \"bn\", IF(Val >= 1000000, FORMAT(Val / 1000000, \"#,0.00\") & \"m\", IF(Val >= 1000, FORMAT(Val / 1000, \"#,0.0\") & \"k\", FORMAT(Val, \"#,0\"))))",
              "VAR MTxt = IF(ISBLANK(M), \"-- vs PM\", UNICHAR(IF(M >= 0, 9650, 9660)) & FORMAT(ABS(M), \"0.00%\") & \" vs PM\")",
              "VAR MCol = IF(ISBLANK(M), Grey, IF(M >= 0, \"rgb(196,48,43)\", \"rgb(27,107,27)\"))",
              "VAR QTxt = IF(ISBLANK(Q), \"-- vs PQ\", UNICHAR(IF(Q >= 0, 9650, 9660)) & FORMAT(ABS(Q), \"0.00%\") & \" vs PQ\")",
              "VAR QCol = IF(ISBLANK(Q), Grey, IF(Q >= 0, \"rgb(196,48,43)\", \"rgb(27,107,27)\"))",
              "VAR YTxt = IF(ISBLANK(Y), \"-- vs PY\", UNICHAR(IF(Y >= 0, 9650, 9660)) & FORMAT(ABS(Y), \"0.00%\") & \" vs PY\")",
              "VAR YCol = IF(ISBLANK(Y), Grey, IF(Y >= 0, \"rgb(196,48,43)\", \"rgb(27,107,27)\"))",
              "RETURN",
              "IF(ISBLANK(Val), BLANK(),",
              "    \"data:image/svg+xml;utf8,\" &",
              "    \"<svg xmlns='http://www.w3.org/2000/svg' width='\" & W & \"' height='\" & H & \"' viewBox='0 0 \" & W & \" \" & H & \"'>\" &",
              "    \"<rect x='0' y='0' width='\" & W & \"' height='\" & H & \"' rx='8' fill='rgb(255,255,255)'/>\" &",
              "    \"<text x='18' y='28' font-family='Segoe UI' font-size='15' font-weight='700' letter-spacing='0.8' fill='rgb(90,86,82)'>COST OF GOODS SOLD</text>\" &",
              "    \"<text x='18' y='84' font-family='Segoe UI' font-size='38' font-weight='600' fill='rgb(18,16,15)'>$\" & ValTxt & \"</text>\" &",
              "    \"<text x='344' y='46' text-anchor='end' font-family='Segoe UI' font-size='14' font-weight='600' fill='\" & MCol & \"'>\" & MTxt & \"</text>\" &",
              "    \"<text x='344' y='68' text-anchor='end' font-family='Segoe UI' font-size='14' font-weight='600' fill='\" & QCol & \"'>\" & QTxt & \"</text>\" &",
              "    \"<text x='344' y='90' text-anchor='end' font-family='Segoe UI' font-size='14' font-weight='600' fill='\" & YCol & \"'>\" & YTxt & \"</text>\" &",
              "    IF(N > 1, \"<polygon points='0,\" & H & \" \" & Pline & \" \" & W & \",\" & H & \"' fill='\" & Line & \"' opacity='0.13'/>\" & \"<polyline points='\" & Pline & \"' fill='none' stroke='\" & Line & \"' stroke-width='2' stroke-linejoin='round'/>\", \"\") &",
              "    \"</svg>\")"
            ],
            "lineageTag": "6c0a9515-52ad-4170-8d8b-243cd6d9a071"
          },
          {
            "name": "KPI Spark - Average Revenue",
            "dataCategory": "ImageUrl",
            "description": "Option 1 sparkline card for Average Revenue (average invoice line value). ImageUrl: render at 362x165.",
            "displayFolder": "KPI Cards",
            "expression": [
              "VAR W = 362",
              "VAR H = 165",
              "VAR SpkTop = 112",
              "VAR SpkBot = 161",
              "VAR Line = \"rgb(143,48,48)\"",
              "VAR Grey = \"rgb(120,115,111)\"",
              "VAR Val = [Avg Revenue]",
              "VAR M = [avg_revenue_mom (%)]",
              "VAR Q = [avg_revenue_qoq (%)]",
              "VAR Y = [avg_revenue_yoy (%)]",
              "VAR Pts = FILTER(ADDCOLUMNS(VALUES('Date table'[Month]), \"@v\", [Avg Revenue]), NOT ISBLANK([@v]))",
              "VAR N = COUNTROWS(Pts)",
              "VAR MaxV = MAXX(Pts, [@v])",
              "VAR MinV = MINX(Pts, [@v])",
              "VAR Rk = ADDCOLUMNS(Pts, \"@i\", RANKX(Pts, 'Date table'[Month], , ASC, DENSE))",
              "VAR Pline = CONCATENATEX(Rk, FORMAT(DIVIDE([@i] - 1, MAX(N - 1, 1)) * W, \"0.0\") & \",\" & FORMAT(SpkBot - DIVIDE([@v] - MinV, MAX(MaxV - MinV, 1)) * (SpkBot - SpkTop), \"0.0\"), \" \", [@i], ASC)",
              "VAR ValTxt = IF(Val >= 1000000, FORMAT(Val / 1000000, \"#,0.00\") & \"m\", IF(Val >= 1000, FORMAT(Val / 1000, \"#,0.0\") & \"k\", FORMAT(Val, \"#,0\")))",
              "VAR MTxt = IF(ISBLANK(M), \"-- vs PM\", UNICHAR(IF(M >= 0, 9650, 9660)) & FORMAT(ABS(M), \"0.00%\") & \" vs PM\")",
              "VAR MCol = IF(ISBLANK(M), Grey, IF(M >= 0, \"rgb(27,107,27)\", \"rgb(196,48,43)\"))",
              "VAR QTxt = IF(ISBLANK(Q), \"-- vs PQ\", UNICHAR(IF(Q >= 0, 9650, 9660)) & FORMAT(ABS(Q), \"0.00%\") & \" vs PQ\")",
              "VAR QCol = IF(ISBLANK(Q), Grey, IF(Q >= 0, \"rgb(27,107,27)\", \"rgb(196,48,43)\"))",
              "VAR YTxt = IF(ISBLANK(Y), \"-- vs PY\", UNICHAR(IF(Y >= 0, 9650, 9660)) & FORMAT(ABS(Y), \"0.00%\") & \" vs PY\")",
              "VAR YCol = IF(ISBLANK(Y), Grey, IF(Y >= 0, \"rgb(27,107,27)\", \"rgb(196,48,43)\"))",
              "RETURN",
              "IF(ISBLANK(Val), BLANK(),",
              "    \"data:image/svg+xml;utf8,\" &",
              "    \"<svg xmlns='http://www.w3.org/2000/svg' width='\" & W & \"' height='\" & H & \"' viewBox='0 0 \" & W & \" \" & H & \"'>\" &",
              "    \"<rect x='0' y='0' width='\" & W & \"' height='\" & H & \"' rx='8' fill='rgb(255,255,255)'/>\" &",
              "    \"<text x='18' y='28' font-family='Segoe UI' font-size='15' font-weight='700' letter-spacing='0.8' fill='rgb(90,86,82)'>AVERAGE REVENUE</text>\" &",
              "    \"<text x='18' y='84' font-family='Segoe UI' font-size='38' font-weight='600' fill='rgb(18,16,15)'>$\" & ValTxt & \"</text>\" &",
              "    \"<text x='344' y='46' text-anchor='end' font-family='Segoe UI' font-size='14' font-weight='600' fill='\" & MCol & \"'>\" & MTxt & \"</text>\" &",
              "    \"<text x='344' y='68' text-anchor='end' font-family='Segoe UI' font-size='14' font-weight='600' fill='\" & QCol & \"'>\" & QTxt & \"</text>\" &",
              "    \"<text x='344' y='90' text-anchor='end' font-family='Segoe UI' font-size='14' font-weight='600' fill='\" & YCol & \"'>\" & YTxt & \"</text>\" &",
              "    IF(N > 1, \"<polygon points='0,\" & H & \" \" & Pline & \" \" & W & \",\" & H & \"' fill='\" & Line & \"' opacity='0.13'/>\" & \"<polyline points='\" & Pline & \"' fill='none' stroke='\" & Line & \"' stroke-width='2' stroke-linejoin='round'/>\", \"\") &",
              "    \"</svg>\")"
            ],
            "lineageTag": "5906f0c1-251f-48f2-8c44-faa7802b81bd"
          },
          {
            "name": "KPI Spark - Orders",
